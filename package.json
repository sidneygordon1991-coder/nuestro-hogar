{
  "name": "nuestro-hogar",
  "private": true,
  "version": "0.38.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && vite build --mode test --outDir dist-e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "bash scripts/db-types.sh",
    "db:baseline": "bash scripts/db-baseline.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "fflate": "0.8.3",
    "jspdf": "4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "postcss": "8.5.30",
    "prettier": "3.8.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^2.1.8"
  }
}
